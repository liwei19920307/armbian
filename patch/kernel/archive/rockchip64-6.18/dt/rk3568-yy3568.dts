		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};
};

&combphy1 {
	phy-supply = <&pcie_oe_regulator>;
	status = "okay";
};

&combphy0 {
	status = "okay";
};

